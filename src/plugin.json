{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Lighthouse API Client",
  "id": "maqsam-lighthouse-api-client-app",
  "backend": true,
  "executable": "gpx_lighthouse_api_client_app",
  "info": {
    "keywords": ["app"],
    "description": "View Lighthouse-managed instances for an environment and cell, and activate or deactivate one at a time.",
    "author": {
      "name": "Maqsam"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Managed instances",
      "path": "/a/%PLUGIN_ID%",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.15",
    "plugins": []
  }
}
